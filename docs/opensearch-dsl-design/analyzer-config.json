{
  "analysis": {
    "analyzer": {
      "natural_language_analyzer": {
        "type": "standard",
        "stopwords": "_english_"
      },
      "dsl_query_analyzer": {
        "type": "custom",
        "tokenizer": "whitespace",
        "filter": [
          "lowercase"
        ]
      },
      "sql_keyword_analyzer": {
        "type": "custom",
        "tokenizer": "sql_keyword_tokenizer",
        "filter": [
          "lowercase",
          "sql_keyword_filter"
        ]
      },
      "mongodb_query_analyzer": {
        "type": "custom",
        "tokenizer": "mongodb_tokenizer",
        "filter": [
          "lowercase",
          "mongodb_keyword_filter"
        ]
      },
      "splunk_spl_analyzer": {
        "type": "custom",
        "tokenizer": "splunk_tokenizer",
        "filter": [
          "lowercase",
          "splunk_keyword_filter"
        ]
      }
    },
    "tokenizer": {
      "sql_keyword_tokenizer": {
        "type": "pattern",
        "pattern": "([\\s,()]+)",
        "group": -1
      },
      "mongodb_tokenizer": {
        "type": "pattern",
        "pattern": "([\\s,{}\\[\\]:()]+)",
        "group": -1
      },
      "splunk_tokenizer": {
        "type": "pattern",
        "pattern": "([\\s|,()\\[\\]]+)",
        "group": -1
      }
    },
    "filter": {
      "sql_keyword_filter": {
        "type": "keyword_marker",
        "keywords": [
          "SELECT",
          "FROM",
          "WHERE",
          "JOIN",
          "LEFT",
          "RIGHT",
          "INNER",
          "OUTER",
          "FULL",
          "CROSS",
          "GROUP",
          "BY",
          "ORDER",
          "HAVING",
          "UNION",
          "INTERSECT",
          "EXCEPT",
          "INSERT",
          "UPDATE",
          "DELETE",
          "CREATE",
          "DROP",
          "ALTER",
          "TABLE",
          "INDEX",
          "VIEW",
          "PROCEDURE",
          "FUNCTION",
          "TRIGGER",
          "AS",
          "ON",
          "AND",
          "OR",
          "NOT",
          "IN",
          "EXISTS",
          "BETWEEN",
          "LIKE",
          "IS",
          "NULL",
          "TRUE",
          "FALSE",
          "DISTINCT",
          "ALL",
          "ANY",
          "SOME",
          "COUNT",
          "SUM",
          "AVG",
          "MAX",
          "MIN",
          "LIMIT",
          "OFFSET",
          "FETCH",
          "CASE",
          "WHEN",
          "THEN",
          "ELSE",
          "END",
          "WITH",
          "RECURSIVE",
          "CTE",
          "OVER",
          "PARTITION",
          "ROW_NUMBER",
          "RANK",
          "DENSE_RANK",
          "LAG",
          "LEAD",
          "FIRST_VALUE",
          "LAST_VALUE",
          "CAST",
          "CONVERT",
          "COALESCE",
          "NULLIF",
          "IFNULL",
          "CONCAT",
          "SUBSTRING",
          "REPLACE",
          "TRIM",
          "UPPER",
          "LOWER",
          "LENGTH",
          "ROUND",
          "FLOOR",
          "CEIL",
          "ABS",
          "POWER",
          "SQRT",
          "DATE",
          "TIME",
          "TIMESTAMP",
          "INTERVAL",
          "EXTRACT",
          "DATE_TRUNC",
          "NOW",
          "CURRENT_DATE",
          "CURRENT_TIME",
          "CURRENT_TIMESTAMP"
        ]
      },
      "mongodb_keyword_filter": {
        "type": "keyword_marker",
        "keywords": [
          "$match",
          "$group",
          "$project",
          "$sort",
          "$limit",
          "$skip",
          "$unwind",
          "$lookup",
          "$addFields",
          "$replaceRoot",
          "$count",
          "$sum",
          "$avg",
          "$min",
          "$max",
          "$push",
          "$addToSet",
          "$first",
          "$last",
          "$eq",
          "$ne",
          "$gt",
          "$gte",
          "$lt",
          "$lte",
          "$in",
          "$nin",
          "$and",
          "$or",
          "$not",
          "$nor",
          "$exists",
          "$type",
          "$regex",
          "$where",
          "$expr",
          "$jsonSchema",
          "$mod",
          "$text",
          "$search",
          "$all",
          "$elemMatch",
          "$size",
          "find",
          "findOne",
          "aggregate",
          "insertOne",
          "insertMany",
          "updateOne",
          "updateMany",
          "deleteOne",
          "deleteMany",
          "replaceOne",
          "countDocuments",
          "distinct"
        ]
      },
      "splunk_keyword_filter": {
        "type": "keyword_marker",
        "keywords": [
          "search",
          "eval",
          "stats",
          "chart",
          "timechart",
          "table",
          "fields",
          "rename",
          "where",
          "sort",
          "head",
          "tail",
          "top",
          "rare",
          "dedup",
          "transaction",
          "join",
          "append",
          "appendcols",
          "lookup",
          "inputlookup",
          "outputlookup",
          "rex",
          "regex",
          "strcat",
          "replace",
          "substr",
          "split",
          "mvexpand",
          "makemv",
          "mvcombine",
          "bin",
          "bucket",
          "convert",
          "fillnull",
          "filldown",
          "streamstats",
          "eventstats",
          "sitimechart",
          "count",
          "sum",
          "avg",
          "min",
          "max",
          "dc",
          "values",
          "list",
          "first",
          "last",
          "earliest",
          "latest",
          "by",
          "as",
          "over",
          "span",
          "index",
          "source",
          "sourcetype",
          "host",
          "earliest",
          "latest",
          "starttime",
          "endtime"
        ]
      }
    }
  }
}
